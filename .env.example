# Copy this file to .env and fill in the values before deploying.
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='django-insecure-t186q3!(m=$*t-6hbwqa8a_1)wck@=yc4a*m0)_(wzzkf_)8rn'

# Comma-separated list of your domains / IPs
DJANGO_ALLOWED_HOSTS=cybflows.com,www.cybflows.com

# ── Optional ──────────────────────────────────────────────────────────────
# Set to "True" only for local development — never in production
DJANGO_DEBUG=False

# Comma-separated trusted origins for CSRF (required if behind a proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=https://cybflows.com,https://www.cybflows.com

# PostgreSQL connection string (leave blank to use SQLite)
DATABASE_URL=

# Your canonical site URL (used in sitemap & canonical tags)
SITE_URL=https://cybflows.com

# Set to "False" if your hosting proxy already handles HTTPS redirects
DJANGO_SECURE_SSL_REDIRECT=True

# Django log level: DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=WARNING
